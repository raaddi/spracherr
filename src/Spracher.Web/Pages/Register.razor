@page "/register"
@inject AuthApiClient AuthApiClient

<PageTitle>Rejestracja — Spracher</PageTitle>

<section class="form-page">
    <p class="eyebrow">Zacznij naukę</p>
    <h1>Załóż konto</h1>
    <p class="form-intro">Po rejestracji wyślemy link potwierdzający adres e-mail.</p>

    @if (_registered)
    {
        <div class="alert alert-success" role="status">
            Konto zostało utworzone. Sprawdź skrzynkę e-mail i potwierdź adres przed logowaniem.
        </div>
        <a class="primary-link" href="/login">Przejdź do logowania</a>
    }
    else
    {
        <ApiErrorSummary ErrorMessage="@_errorMessage" Errors="@_errors" />
        <EditForm Model="@_model" OnValidSubmit="SubmitAsync" FormName="register" class="form-card">
            <DataAnnotationsValidator />
            <div class="field">
                <label for="register-name">Nazwa wyświetlana</label>
                <InputText id="register-name" autocomplete="name" @bind-Value="_model.DisplayName" />
                <ValidationMessage For="@(() => _model.DisplayName)" />
            </div>
            <div class="field">
                <label for="register-email">E-mail</label>
                <InputText id="register-email" type="email" autocomplete="email" @bind-Value="_model.Email" />
                <ValidationMessage For="@(() => _model.Email)" />
            </div>
            <div class="field">
                <label for="register-password">Hasło</label>
                <InputText id="register-password" type="password" autocomplete="new-password" @bind-Value="_model.Password" />
                <small>Minimum 10 znaków, mała i wielka litera, cyfra oraz znak specjalny.</small>
                <ValidationMessage For="@(() => _model.Password)" />
            </div>
            <div class="field">
                <label for="register-confirm">Powtórz hasło</label>
                <InputText id="register-confirm" type="password" autocomplete="new-password" @bind-Value="_model.ConfirmPassword" />
                <ValidationMessage For="@(() => _model.ConfirmPassword)" />
            </div>
            <button class="primary-button" type="submit" disabled="@_isSubmitting">
                @(_isSubmitting ? "Tworzenie konta…" : "Utwórz konto")
            </button>
        </EditForm>
    }
</section>

@code {
    private readonly RegisterModel _model = new();
    private IReadOnlyDictionary<string, string[]> _errors = new Dictionary<string, string[]>();
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _registered;

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;
        _errors = new Dictionary<string, string[]>();
        try
        {
            var result = await AuthApiClient.RegisterAsync(new RegisterRequest(
                _model.Email,
                _model.Password,
                _model.DisplayName,
                TimeZoneInfo.Local.Id));
            _registered = result.Succeeded;
            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage;
                _errors = result.Errors;
            }
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Nie udało się połączyć z API.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Podaj nazwę wyświetlaną.")]
        [StringLength(80, MinimumLength = 2, ErrorMessage = "Nazwa musi mieć od 2 do 80 znaków.")]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Podaj adres e-mail.")]
        [EmailAddress(ErrorMessage = "Podaj poprawny adres e-mail.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Podaj hasło.")]
        [MinLength(10, ErrorMessage = "Hasło musi mieć co najmniej 10 znaków.")]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "Hasła nie są takie same.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
