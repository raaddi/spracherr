@page "/practice"
@using Spracher.Contracts.Exercises
@inject ExercisesApiClient ExercisesApiClient
@inject AppSessionState SessionState

<PageTitle>Ćwiczenia — Spracher</PageTitle>

<section class="practice-page">
    <p class="eyebrow">Trening językowy</p>
    <h1>Ćwiczenia</h1>
    <p class="form-intro">
        Wybierz krótki zestaw albo pojedyncze zadanie. Każda próba korzysta z zapisanej wersji,
        a odpowiedź ocenia backend bez wysyłania klucza do przeglądarki.
    </p>

    <ApiErrorSummary ErrorMessage="@_errorMessage" Errors="@_errors" />

    @if (_isLoading)
    {
        <p role="status">Ładowanie ćwiczeń…</p>
    }
    else if (_catalog.Count == 0 && _sets.Count == 0)
    {
        <div class="empty-state">
            <h2>Brak opublikowanych ćwiczeń</h2>
            <p>Pierwsze zadania pojawią się tutaj po publikacji.</p>
        </div>
    }
    else if (_play is null)
    {
        @if (_sets.Count > 0)
        {
            <section class="practice-section" aria-labelledby="exercise-sets-title">
                <div class="practice-section-heading">
                    <div>
                        <p class="eyebrow">Prowadzona sesja</p>
                        <h2 id="exercise-sets-title">Zestawy treningowe</h2>
                    </div>
                    <span>@_sets.Count</span>
                </div>

                <div class="exercise-catalog">
                    @foreach (var set in _sets)
                    {
                        <article class="exercise-catalog-card exercise-set-card">
                            <div>
                                <span class="exercise-type">Zestaw · @set.Exercises.Count ćw.</span>
                                <h2>@set.Title</h2>
                                <p>@set.Description</p>
                                <ol class="exercise-set-preview">
                                    @foreach (var exercise in set.Exercises)
                                    {
                                        <li>
                                            <span>@exercise.Position</span>
                                            <span>
                                                <strong>@exercise.Title</strong>
                                                <small>@TypeLabel(exercise.TypeKey) · v@(exercise.VersionNumber)</small>
                                            </span>
                                        </li>
                                    }
                                </ol>
                            </div>

                            @if (SessionState.Session.IsAuthenticated)
                            {
                                <button class="primary-button"
                                        type="button"
                                        disabled="@_isBusy"
                                        @onclick="() => StartSetAsync(set)">
                                    @(_isBusy ? "Uruchamiam…" : "Rozpocznij zestaw")
                                </button>
                            }
                            else
                            {
                                <a class="primary-link" href="/login">Zaloguj się i rozpocznij</a>
                            }
                        </article>
                    }
                </div>
            </section>
        }

        @if (_catalog.Count > 0)
        {
            <section class="practice-section" aria-labelledby="single-exercises-title">
                <div class="practice-section-heading">
                    <div>
                        <p class="eyebrow">Na szybko</p>
                        <h2 id="single-exercises-title">Pojedyncze ćwiczenia</h2>
                    </div>
                    <span>@_catalog.Count</span>
                </div>

                <div class="exercise-catalog" aria-label="Dostępne ćwiczenia">
                    @foreach (var item in _catalog)
                    {
                        <article class="exercise-catalog-card">
                            <div>
                                <span class="exercise-type">@TypeLabel(item.TypeKey) · v@(item.VersionNumber)</span>
                                <h2>@item.Title</h2>
                                <p>@item.Description</p>
                                <small>@item.Prompt</small>
                            </div>

                            @if (SessionState.Session.IsAuthenticated)
                            {
                                <button class="primary-button"
                                        type="button"
                                        disabled="@_isBusy"
                                        @onclick="() => StartAsync(item.DefinitionId)">
                                    @(_isBusy ? "Uruchamiam…" : "Rozpocznij")
                                </button>
                            }
                            else
                            {
                                <a class="primary-link" href="/login">Zaloguj się i rozwiąż</a>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    }
    else
    {
        <article class="exercise-player" aria-labelledby="exercise-title">
            <header class="exercise-player-header">
                <div>
                    <span class="exercise-type">
                        @if (_activeSet is not null)
                        {
                            <text>@_activeSet.Title · </text>
                        }
                        @TypeLabel(_play.TypeKey)
                    </span>
                    <h2 id="exercise-title">@_play.Title</h2>
                </div>
                <span class="exercise-progress">@ProgressLabel</span>
            </header>

            <p class="exercise-prompt">@_play.Prompt</p>

            <ExerciseRendererHost TypeKey="@_play.TypeKey"
                                  Payload="@_play.Payload"
                                  Disabled="@(_isBusy || _result is not null)"
                                  ResponseChanged="OnResponseChanged" />

            @if (_result is not null)
            {
                <section class="exercise-result @(_result.IsCorrect ? "is-correct" : "is-incorrect")"
                         aria-live="polite">
                    <div>
                        <strong>@(_result.IsCorrect ? "Dobrze!" : "Jeszcze nie tym razem")</strong>
                        <p>@_result.Feedback</p>
                    </div>
                    <span>@_result.AwardedPoints / @_result.MaxPoints pkt</span>
                </section>

                @if (_activeSet is not null && _activeSetIndex + 1 < _activeSet.Exercises.Count)
                {
                    <button class="primary-button" type="button" disabled="@_isBusy" @onclick="NextSetItemAsync">
                        @(_isBusy ? "Uruchamiam…" : "Następne ćwiczenie")
                    </button>
                }
                else if (_activeSet is not null)
                {
                    <button class="primary-button" type="button" @onclick="ResetPlayer">
                        Zakończ zestaw
                    </button>
                }
                else
                {
                    <button class="primary-button" type="button" @onclick="ResetPlayer">
                        Wróć do listy
                    </button>
                }
            }
            else
            {
                <button class="primary-button"
                        type="button"
                        disabled="@(_isBusy || _response is null)"
                        @onclick="SubmitAsync">
                    @(_isBusy ? "Sprawdzam…" : "Sprawdź odpowiedź")
                </button>
            }
        </article>
    }
</section>

@code {
    private readonly List<ExerciseCatalogItemResponse> _catalog = [];
    private readonly List<ExerciseSetCatalogItemResponse> _sets = [];
    private IReadOnlyDictionary<string, string[]> _errors =
        new Dictionary<string, string[]>();
    private ExerciseSetCatalogItemResponse? _activeSet;
    private ExercisePlayResponse? _play;
    private ExerciseResultResponse? _result;
    private System.Text.Json.JsonElement? _response;
    private string? _errorMessage;
    private int _activeSetIndex;
    private bool _isLoading = true;
    private bool _isBusy;

    private string ProgressLabel => _activeSet is null
        ? "1 / 1"
        : $"{_activeSetIndex + 1} / {_activeSet.Exercises.Count}";

    protected override async Task OnInitializedAsync()
    {
        await SessionState.InitializeAsync();
        var catalogTask = ExercisesApiClient.GetCatalogAsync();
        var setsTask = ExercisesApiClient.GetSetCatalogAsync();
        await Task.WhenAll(catalogTask, setsTask);

        var catalogResult = await catalogTask;
        if (catalogResult.Succeeded && catalogResult.Value is not null)
        {
            _catalog.AddRange(catalogResult.Value.Items);
        }
        else
        {
            SetError(catalogResult);
        }

        var setsResult = await setsTask;
        if (setsResult.Succeeded && setsResult.Value is not null)
        {
            _sets.AddRange(setsResult.Value.Items);
        }
        else
        {
            SetError(setsResult);
        }

        _isLoading = false;
    }

    private async Task StartAsync(Guid definitionId)
    {
        _activeSet = null;
        _activeSetIndex = 0;
        await LoadAttemptAsync(() => ExercisesApiClient.StartAttemptAsync(definitionId));
    }

    private async Task StartSetAsync(ExerciseSetCatalogItemResponse set)
    {
        _activeSet = set;
        _activeSetIndex = 0;
        if (!await StartSetItemAsync(index: 0))
        {
            _activeSet = null;
        }
    }

    private async Task NextSetItemAsync()
    {
        if (_activeSet is null || _activeSetIndex + 1 >= _activeSet.Exercises.Count)
        {
            return;
        }

        await StartSetItemAsync(_activeSetIndex + 1);
    }

    private async Task<bool> StartSetItemAsync(int index)
    {
        if (_activeSet is null)
        {
            return false;
        }

        var item = _activeSet.Exercises[index];
        var succeeded = await LoadAttemptAsync(() =>
            ExercisesApiClient.StartSetItemAttemptAsync(_activeSet.SetId, item.ItemId));
        if (succeeded)
        {
            _activeSetIndex = index;
        }

        return succeeded;
    }

    private async Task<bool> LoadAttemptAsync(
        Func<Task<ApiResult<ExercisePlayResponse>>> starter)
    {
        ClearError();
        _isBusy = true;
        try
        {
            var result = await starter();
            if (!result.Succeeded || result.Value is null)
            {
                SetError(result);
                return false;
            }

            _play = result.Value;
            _result = null;
            _response = null;
            return true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_play is null || _response is null)
        {
            return;
        }

        ClearError();
        _isBusy = true;
        try
        {
            var result = await ExercisesApiClient.SubmitAttemptAsync(
                _play.AttemptId,
                new SubmitExerciseAttemptRequest(_response.Value));
            if (result.Succeeded && result.Value is not null)
            {
                _result = result.Value;
            }
            else
            {
                SetError(result);
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnResponseChanged(System.Text.Json.JsonElement? response) =>
        _response = response;

    private void ResetPlayer()
    {
        _activeSet = null;
        _activeSetIndex = 0;
        _play = null;
        _result = null;
        _response = null;
        ClearError();
    }

    private void SetError<T>(ApiResult<T> result)
    {
        _errorMessage = result.ErrorMessage;
        _errors = result.Errors;
    }

    private void ClearError()
    {
        _errorMessage = null;
        _errors = new Dictionary<string, string[]>();
    }

    private static string TypeLabel(string typeKey) => typeKey switch
    {
        "multiple-choice" => "Wielokrotny wybór",
        "fill-in-blank" => "Uzupełnij lukę",
        "translation" => "Tłumaczenie",
        _ => typeKey,
    };
}
