@page "/reset-password"
@inject AuthApiClient AuthApiClient

<PageTitle>Nowe hasło — Spracher</PageTitle>

<section class="form-page">
    <p class="eyebrow">Bezpieczeństwo konta</p>
    <h1>Ustaw nowe hasło</h1>

    @if (_completed)
    {
        <div class="alert alert-success" role="status">Hasło zostało zmienione.</div>
        <a class="primary-link" href="/login">Zaloguj się</a>
    }
    else if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Code))
    {
        <div class="alert alert-error" role="alert">Link resetujący jest niepełny.</div>
    }
    else
    {
        <ApiErrorSummary ErrorMessage="@_errorMessage" Errors="@_errors" />
        <EditForm Model="@_model" OnValidSubmit="SubmitAsync" FormName="reset-password" class="form-card">
            <DataAnnotationsValidator />
            <div class="field">
                <label for="reset-password">Nowe hasło</label>
                <InputText id="reset-password" type="password" autocomplete="new-password" @bind-Value="_model.Password" />
                <ValidationMessage For="@(() => _model.Password)" />
            </div>
            <div class="field">
                <label for="reset-confirm">Powtórz hasło</label>
                <InputText id="reset-confirm" type="password" autocomplete="new-password" @bind-Value="_model.ConfirmPassword" />
                <ValidationMessage For="@(() => _model.ConfirmPassword)" />
            </div>
            <button class="primary-button" type="submit" disabled="@_isSubmitting">Zmień hasło</button>
        </EditForm>
    }
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Code { get; set; }

    private readonly PasswordModel _model = new();
    private IReadOnlyDictionary<string, string[]> _errors = new Dictionary<string, string[]>();
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _completed;

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        try
        {
            var result = await AuthApiClient.ResetPasswordAsync(
                new ResetPasswordRequest(Email!, Code!, _model.Password));
            _completed = result.Succeeded;
            _errorMessage = result.ErrorMessage;
            _errors = result.Errors;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Nie udało się połączyć z API.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class PasswordModel
    {
        [Required(ErrorMessage = "Podaj nowe hasło.")]
        [MinLength(10, ErrorMessage = "Hasło musi mieć co najmniej 10 znaków.")]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "Hasła nie są takie same.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
