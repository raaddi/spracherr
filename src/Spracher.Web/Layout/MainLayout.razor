@inherits LayoutComponentBase
@implements IDisposable
@inject AppSessionState SessionState
@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<div class="app-shell">
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="/" aria-label="Spracher — strona główna">
                <span class="brand-symbol" aria-hidden="true">A</span>
                <span class="brand-copy">
                    <strong>Spracher</strong>
                    <small>Language learning</small>
                </span>
            </a>

            <nav class="topnav" aria-label="Główna nawigacja">
                <div class="nav-group nav-learning">
                    <span class="nav-group-label">Nauka</span>
                    <div class="nav-links">
                        <NavLink href="/" Match="NavLinkMatch.All">
                            <NavigationIcon Name="home" />
                            <span>Start</span>
                        </NavLink>
                        <NavLink href="/vocabulary" Match="NavLinkMatch.All">
                            <NavigationIcon Name="book" />
                            <span>Słownictwo</span>
                        </NavLink>
                        @if (SessionState.Session.IsAuthenticated)
                        {
                            <NavLink href="/vocabulary/manage" Match="NavLinkMatch.All">
                                <NavigationIcon Name="collection" />
                                <span>Mój słownik</span>
                            </NavLink>
                            <NavLink href="/languages" Match="NavLinkMatch.All">
                                <NavigationIcon Name="language" />
                                <span>Języki</span>
                            </NavLink>
                        }
                    </div>
                </div>

                <div class="nav-group nav-account">
                    <span class="nav-group-label">Konto</span>
                    <div class="nav-links">
                        @if (SessionState.Session.IsAuthenticated)
                        {
                            <NavLink href="/profile" Match="NavLinkMatch.All">
                                <NavigationIcon Name="user" />
                                <span>@SessionState.Session.User?.DisplayName</span>
                            </NavLink>
                            <button type="button" disabled="@_isSigningOut" @onclick="SignOutAsync">
                                <NavigationIcon Name="logout" />
                                <span>Wyloguj</span>
                            </button>
                        }
                        else
                        {
                            <NavLink href="/login" Match="NavLinkMatch.All">
                                <NavigationIcon Name="login" />
                                <span>Zaloguj</span>
                            </NavLink>
                            <NavLink class="nav-primary" href="/register" Match="NavLinkMatch.All">
                                <NavigationIcon Name="register" />
                                <span>Załóż konto</span>
                            </NavLink>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    private bool _isSigningOut;

    protected override async Task OnInitializedAsync()
    {
        SessionState.Changed += OnSessionChanged;

        try
        {
            await SessionState.InitializeAsync();
        }
        catch (HttpRequestException)
        {
            // The home page exposes API availability; navigation remains usable offline.
        }
    }

    public void Dispose()
    {
        SessionState.Changed -= OnSessionChanged;
        GC.SuppressFinalize(this);
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task SignOutAsync()
    {
        _isSigningOut = true;
        try
        {
            var result = await AuthApiClient.LogoutAsync();
            if (result.Succeeded)
            {
                SessionState.Set(new AuthSessionResponse(false, null));
                Navigation.NavigateTo("/");
            }
        }
        finally
        {
            _isSigningOut = false;
        }
    }
}
